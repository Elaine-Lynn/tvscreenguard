<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-feature android:name="android.software.leanback" android:required="false"/>
 <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
 <uses-permission android:name="android.permission.INTERNET"/>
 <queries>
  <provider android:authorities="com.dangbei.dangbeiref.data"/>
  <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent>
  <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
  <intent><action android:name="android.settings.ACCESSIBILITY_SETTINGS"/></intent>
 </queries>
 <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:banner="@drawable/banner" android:theme="@style/AppTheme" android:allowBackup="false" android:localeConfig="@xml/locales_config" android:supportsRtl="true">
  <activity android:name=".ChildSettingsActivity" android:exported="true" android:screenOrientation="landscape">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
  </activity>
  <activity android:name=".ChildChallengeActivity" android:exported="false" android:excludeFromRecents="true" android:launchMode="singleTask" android:taskAffinity="${applicationId}.challenge" android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"/>
  <service android:name=".ChildWatchService" android:label="@string/app_name" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
   <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
   <meta-data android:name="android.accessibilityservice" android:resource="@xml/child_watch_service"/>
  </service>
 </application>
</manifest>